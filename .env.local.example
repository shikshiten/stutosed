# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Cloudflare Worker Smart Stream Proxy (Optional, defaults to seiryu.stutosed.workers.dev)
NEXT_PUBLIC_STREAM_PROXY_URL=https://seiryu.stutosed.workers.dev

# Website Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rate Limiting: Upstash Redis or Vercel KV REST (Optional)
# If omitted or unavailable, the system automatically falls back to the in-memory sliding window limiter.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Or Vercel KV aliases:
# KV_REST_API_URL=https://your-kv.vercel-storage.com
# KV_REST_API_TOKEN=your-vercel-kv-token
